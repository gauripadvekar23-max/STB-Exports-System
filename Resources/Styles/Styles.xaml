<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================= -->
    <!-- LABEL -->
    <!-- ============================= -->

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="TextColor" Value="{StaticResource BodyText}" />
    </Style>

    <!-- ============================= -->
    <!-- ENTRY -->
    <!-- ============================= -->

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource EntryBackground}" />
        <Setter Property="TextColor" Value="{StaticResource EntryText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource PlaceholderText}" />
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="HeightRequest" Value="55"/>
    </Style>

    <!-- ============================= -->
    <!-- BUTTON -->
    <!-- ============================= -->

    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="HeightRequest" Value="60"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlue}"/>
        <Setter Property="TextColor" Value="White"/>
    </Style>

    <!-- ============================= -->
    <!-- CHECKBOX -->
    <!-- ============================= -->

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Gold}"/>
    </Style>

</ResourceDictionary>