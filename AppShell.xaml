<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="STB_Exports.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:STB_Exports.Views"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <!-- ===================================================== -->
    <!-- CUSTOMER PORTAL                                      -->
    <!-- ===================================================== -->

    <ShellContent
        Route="CustomerLoginPage"
        ContentTemplate="{DataTemplate views:CustomerLoginPage}" />

    <ShellContent
        Route="CustomerRegistrationPage"
        ContentTemplate="{DataTemplate views:CustomerRegistrationPage}" />

    <ShellContent
        Route="HomePage"
        ContentTemplate="{DataTemplate views:HomePage}" />

</Shell>