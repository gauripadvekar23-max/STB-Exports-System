<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="STB_Exports.Views.CustomerProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:STB_Exports.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===================================================== -->
        <!-- CUSTOMER HEADER -->
        <!-- ===================================================== -->

        <views:CustomerHeaderFooter
            Grid.Row="0" />

        <!-- ===================================================== -->
        <!-- MAIN PROFILE CONTENT -->
        <!-- ===================================================== -->

        <ScrollView
            Grid.Row="1">

            <VerticalStackLayout
                Spacing="0"
                Padding="0,0,0,30">

                <!-- ================================================= -->
                <!-- PERSONAL INFORMATION -->
                <!-- ================================================= -->

                <Frame
                    Margin="15,20,15,10"
                    Padding="20"
                    CornerRadius="20"
                    BackgroundColor="White"
                    BorderColor="Goldenrod"
                    HasShadow="True">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Personal Information"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="DarkSlateGray"/>

                        <Label
                            Text="Full Name"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue"/>

                        <Entry
                            x:Name="FullNameEntry"
                            Placeholder="Enter your full name"
                            TextColor="Black"
                            PlaceholderColor="Gray"
                            BackgroundColor="White"
                            IsReadOnly="True"/>

                        <Label
                            Text="Email Address"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue"/>

                        <Entry
                            x:Name="EmailEntry"
                            Placeholder="Enter your email"
                            Keyboard="Email"
                            TextColor="Black"
                            PlaceholderColor="Gray"
                            BackgroundColor="White"
                            IsReadOnly="True"/>

                        <Label
                            Text="Phone Number"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue"/>

                        <Entry
                            x:Name="PhoneEntry"
                            Placeholder="Enter your phone number"
                            Keyboard="Telephone"
                            TextColor="Black"
                            PlaceholderColor="Gray"
                            BackgroundColor="White"
                            IsReadOnly="True"/>

                    </VerticalStackLayout>

                </Frame>


                <!-- ================================================= -->
                <!-- DELIVERY ADDRESS -->
                <!-- ================================================= -->

                <Frame
                    Margin="15,10,15,10"
                    Padding="20"
                    CornerRadius="20"
                    BackgroundColor="White"
                    BorderColor="Goldenrod"
                    HasShadow="True">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Delivery Address"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="DarkSlateGray"/>

                        <Label
                            Text="Address"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue"/>

                        <Editor
                            x:Name="AddressEntry"
                            Placeholder="House / Street / Area"
                            TextColor="Black"
                            PlaceholderColor="Gray"
                            BackgroundColor="White"
                            HeightRequest="90"
                            IsReadOnly="True"/>

                        <Label
                            Text="City"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue"/>

                        <Entry
                            x:Name="CityEntry"
                            Placeholder="Enter city"
                            TextColor="Black"
                            PlaceholderColor="Gray"
                            BackgroundColor="White"
                            IsReadOnly="True"/>

                        <Label
    Text="District"
    FontAttributes="Bold"
    TextColor="MidnightBlue"/>

                        <Entry
    x:Name="DistrictEntry"
    Placeholder="Enter district"
    TextColor="Black"
    PlaceholderColor="Gray"
    BackgroundColor="White"/>


                        <Label
                            Text="State"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue"/>

                        <Entry
                            x:Name="StateEntry"
                            Placeholder="Enter state"
                            TextColor="Black"
                            PlaceholderColor="Gray"
                            BackgroundColor="White"
                            IsReadOnly="True"/>

                        <Label
                            Text="Pincode"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue"/>

                        <Entry
                            x:Name="PincodeEntry"
                            Placeholder="Enter pincode"
                            Keyboard="Numeric"
                            TextColor="Black"
                            PlaceholderColor="Gray"
                            BackgroundColor="White"
                            IsReadOnly="True"/>

                    </VerticalStackLayout>

                </Frame>


                <!-- ================================================= -->
                <!-- SAVE / EDIT PROFILE -->
                <!-- ================================================= -->

                <Button
                    x:Name="ProfileActionButton"
                    Text="SAVE PROFILE"
                    Clicked="ProfileActionButton_Clicked"
                    Margin="20,10,20,25"
                    HeightRequest="52"
                    CornerRadius="18"
                    BackgroundColor="Goldenrod"
                    TextColor="White"
                    FontSize="17"
                    FontAttributes="Bold"/>


                <!-- ================================================= -->
                <!-- ACCOUNT OPTIONS -->
                <!-- ================================================= -->

                <Frame
                    Margin="15,5,15,20"
                    Padding="10"
                    CornerRadius="20"
                    BackgroundColor="White"
                    BorderColor="LightGray"
                    HasShadow="True">

                    <VerticalStackLayout Spacing="2">

                        <Label
                            Text="Account"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="DarkSlateGray"
                            Margin="10,5,10,10"/>

                        <!-- ORDERS -->

                        <Grid
                            Padding="12"
                            ColumnDefinitions="45,*,35">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OrdersButton_Clicked"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Grid.Column="0"
                                Text="📦"
                                FontSize="25"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="My Orders"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="Black"/>

                                <Label
                                    Text="View your orders and delivery status"
                                    FontSize="12"
                                    TextColor="Gray"/>

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="28"
                                TextColor="Goldenrod"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"/>

                        </Grid>


                        <!-- REVIEWS -->

                        <Grid
                            Padding="12"
                            ColumnDefinitions="45,*,35">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="ReviewsButton_Clicked"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Grid.Column="0"
                                Text="⭐"
                                FontSize="24"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="My Reviews"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="Black"/>

                                <Label
                                    Text="Review products you have purchased"
                                    FontSize="12"
                                    TextColor="Gray"/>

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="28"
                                TextColor="Goldenrod"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"/>

                        </Grid>


                        <!-- WISHLIST -->

                        <Grid
                            Padding="12"
                            ColumnDefinitions="45,*,35">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="WishlistButton_Clicked"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Grid.Column="0"
                                Text="♡"
                                FontSize="29"
                                TextColor="IndianRed"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="Wishlist"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="Black"/>

                                <Label
                                    Text="View products saved for later"
                                    FontSize="12"
                                    TextColor="Gray"/>

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="28"
                                TextColor="Goldenrod"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"/>

                        </Grid>


                        <!-- HELP CENTER -->

                        <Grid
                            Padding="12"
                            ColumnDefinitions="45,*,35">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="HelpCenterButton_Clicked"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Grid.Column="0"
                                Text="💬"
                                FontSize="25"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="Help Center"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="Black"/>

                                <Label
                                    Text="Get help with products and delivery"
                                    FontSize="12"
                                    TextColor="Gray"/>

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="28"
                                TextColor="Goldenrod"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"/>

                        </Grid>


                        <!-- SETTINGS -->

                        <Grid
                            Padding="12"
                            ColumnDefinitions="45,*,35">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="SettingsButton_Clicked"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Grid.Column="0"
                                Text="⚙"
                                FontSize="25"
                                TextColor="DarkSlateGray"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="Settings"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="Black"/>

                                <Label
                                    Text="Notifications and app preferences"
                                    FontSize="12"
                                    TextColor="Gray"/>

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="28"
                                TextColor="Goldenrod"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"/>

                        </Grid>

                    </VerticalStackLayout>

                </Frame>


                <!-- LOGOUT -->

                <Button
                    Text="Logout"
                    Clicked="LogoutButton_Clicked"
                    Margin="20,0,20,30"
                    HeightRequest="48"
                    CornerRadius="18"
                    BackgroundColor="Transparent"
                    TextColor="IndianRed"
                    FontAttributes="Bold"/>

            </VerticalStackLayout>

        </ScrollView>


        <!-- ===================================================== -->
        <!-- FIXED BOTTOM NAVIGATION -->
        <!-- ===================================================== -->

        <views:CustomerBottomNavigation
            Grid.Row="2" />

    </Grid>

</ContentPage>