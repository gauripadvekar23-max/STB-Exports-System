<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="STB_Exports.Views.CheckoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:STB_Exports.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,70">

        <!-- ================================================= -->
        <!-- CUSTOMER HEADER + FOOTER -->
        <!-- ================================================= -->

        <views:CustomerHeaderFooter
            Grid.Row="0" />


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <ScrollView
            Grid.Row="1">

            <VerticalStackLayout
                Padding="12"
                Spacing="12">


                <!-- ================= DELIVERY ADDRESS ================= -->

                <Frame
                    Padding="15"
                    CornerRadius="15"
                    BackgroundColor="White"
                    BorderColor="#DDDDDD"
                    HasShadow="True">

                    <VerticalStackLayout
                        Spacing="8">

                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Text="Delivery Address"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="MidnightBlue" />

                            <Button
                                Grid.Column="1"
                                Text="Change"
                                Clicked="ChangeAddressButton_Clicked"
                                BackgroundColor="Transparent"
                                TextColor="Goldenrod"
                                FontAttributes="Bold"
                                Padding="5" />

                        </Grid>


                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#EEEEEE" />


                        <Label
                            x:Name="CustomerNameLabel"
                            Text="Customer Name"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="Black" />


                        <Label
                            x:Name="CustomerPhoneLabel"
                            Text=""
                            FontSize="14"
                            TextColor="Gray" />


                        <Label
                            x:Name="CustomerAddressLabel"
                            Text=""
                            FontSize="14"
                            TextColor="Black" />


                        <Label
                            x:Name="CustomerCityStateLabel"
                            Text=""
                            FontSize="14"
                            TextColor="Gray" />

                    </VerticalStackLayout>

                </Frame>


                <!-- ================= ORDER ITEMS ================= -->

                <Frame
                    Padding="15"
                    CornerRadius="15"
                    BackgroundColor="White"
                    BorderColor="#DDDDDD"
                    HasShadow="True">

                    <VerticalStackLayout
                        Spacing="10">

                        <Label
                            Text="Order Items"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue" />


                        <CollectionView
                            x:Name="CheckoutItemsCollection"
                            SelectionMode="None">

                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Grid
                                        ColumnDefinitions="75,*,Auto"
                                        RowDefinitions="Auto,Auto"
                                        Padding="0,8">

                                        <!-- IMAGE -->

                                        <Image
                                            Grid.RowSpan="2"
                                            Grid.Column="0"
                                            Source="{Binding ProductImage}"
                                            WidthRequest="65"
                                            HeightRequest="65"
                                            Aspect="AspectFit" />


                                        <!-- NAME -->

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding ProductName}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="Black"
                                            LineBreakMode="TailTruncation" />


                                        <!-- QUANTITY -->

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding DisplayQuantity}"
                                            FontSize="13"
                                            TextColor="Gray" />


                                        <!-- TOTAL -->

                                        <Label
                                            Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Text="{Binding TotalPrice, StringFormat='₹{0:0.00}'}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="Goldenrod"
                                            VerticalOptions="Center" />

                                    </Grid>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Frame>


                <!-- ================= PRICE DETAILS ================= -->

                <Frame
                    Padding="15"
                    CornerRadius="15"
                    BackgroundColor="White"
                    BorderColor="#DDDDDD"
                    HasShadow="True">

                    <VerticalStackLayout
                        Spacing="12">

                        <Label
                            Text="Price Details"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue" />


                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Text="Items Total"
                                FontSize="15"
                                TextColor="Gray" />

                            <Label
                                x:Name="ItemsTotalLabel"
                                Grid.Column="1"
                                Text="₹0.00"
                                FontSize="15"
                                TextColor="Black" />

                        </Grid>


                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Text="Delivery Charges"
                                FontSize="15"
                                TextColor="Gray" />

                            <Label
                                x:Name="DeliveryChargesLabel"
                                Grid.Column="1"
                                Text="FREE"
                                FontSize="15"
                                TextColor="ForestGreen"
                                FontAttributes="Bold" />

                        </Grid>


                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#DDDDDD" />


                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Text="Total Amount"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="Black" />

                            <Label
                                x:Name="TotalAmountLabel"
                                Grid.Column="1"
                                Text="₹0.00"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="Goldenrod" />

                        </Grid>

                    </VerticalStackLayout>

                </Frame>


                <!-- ================= PAYMENT BUTTON ================= -->

                <Button
                    Text="Continue to Payment"
                    Clicked="ContinueToPaymentButton_Clicked"
                    BackgroundColor="Goldenrod"
                    TextColor="White"
                    FontSize="17"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    CornerRadius="15"
                    Margin="0,5,0,20" />

            </VerticalStackLayout>

        </ScrollView>


        <!-- ================================================= -->
        <!-- BOTTOM NAVIGATION -->
        <!-- ================================================= -->

        <views:CustomerBottomNavigation
            Grid.Row="2" />

    </Grid>

</ContentPage>