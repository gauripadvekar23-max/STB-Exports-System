<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="STB_Exports.Views.CartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:STB_Exports.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="80,*,Auto,75">

        <!-- ===================================================== -->
        <!-- CUSTOMER HEADER -->
        <!-- ===================================================== -->

        <views:CustomerHeaderFooter
            Grid.Row="0" />


        <!-- ================= CART ITEMS ================= -->

        <CollectionView
            x:Name="CartCollectionView"
            Grid.Row="1"
            SelectionMode="None"
            Margin="10">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="15">

                    <Label
                        Text="🛒"
                        FontSize="60"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your cart is empty"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="Black"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Add some products to your cart."
                        FontSize="15"
                        TextColor="Gray"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame
                        Margin="5"
                        Padding="10"
                        CornerRadius="18"
                        BackgroundColor="White"
                        BorderColor="#DDDDDD"
                        HasShadow="True">

                        <Grid
                            ColumnDefinitions="90,*,Auto"
                            RowDefinitions="Auto,Auto,Auto">

                            <!-- PRODUCT IMAGE -->

                            <Image
                                Grid.RowSpan="3"
                                Grid.Column="0"
                                Source="{Binding ProductImage}"
                                WidthRequest="80"
                                HeightRequest="80"
                                Aspect="AspectFit"
                                VerticalOptions="Center" />


                            <!-- PRODUCT NAME -->

                            <Label
                                Grid.Column="1"
                                Text="{Binding ProductName}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="Black"
                                LineBreakMode="TailTruncation" />


                            <!-- PRICE -->

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding DisplayPrice}"
                                FontSize="15"
                                TextColor="Goldenrod"
                                FontAttributes="Bold" />


                            <!-- QUANTITY -->

                            <HorizontalStackLayout
                                Grid.Row="2"
                                Grid.Column="1"
                                Spacing="8"
                                VerticalOptions="Center">

                                <Button
                                    Text="−"
                                    Clicked="DecreaseQuantity_Clicked"
                                    CommandParameter="{Binding .}"
                                    WidthRequest="38"
                                    HeightRequest="35"
                                    Padding="0"
                                    FontSize="20"
                                    BackgroundColor="#EEEEEE"
                                    TextColor="Black"
                                    CornerRadius="10" />

                                <Label
                                    Text="{Binding DisplayQuantity}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="Black"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    WidthRequest="65" />

                                <Button
                                    Text="+"
                                    Clicked="IncreaseQuantity_Clicked"
                                    CommandParameter="{Binding .}"
                                    WidthRequest="38"
                                    HeightRequest="35"
                                    Padding="0"
                                    FontSize="20"
                                    BackgroundColor="#EEEEEE"
                                    TextColor="Black"
                                    CornerRadius="10" />

                            </HorizontalStackLayout>


                            <!-- REMOVE -->

                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                Text="✕"
                                Clicked="RemoveItem_Clicked"
                                CommandParameter="{Binding .}"
                                BackgroundColor="Transparent"
                                TextColor="Red"
                                FontSize="18"
                                Padding="5" />


                            <!-- ITEM TOTAL -->

                            <Label
                                Grid.Row="2"
                                Grid.Column="2"
                                Text="{Binding TotalPrice, StringFormat='₹{0:F2}'}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="MidnightBlue"
                                VerticalOptions="Center" />

                        </Grid>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>


        <!-- ================= BOTTOM TOTAL ================= -->

        <Frame
            Grid.Row="2"
            Padding="18,15"
            CornerRadius="20"
            BackgroundColor="White"
            BorderColor="#DDDDDD"
            HasShadow="True"
            Margin="10">

            <Grid
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto,55"
                RowSpacing="8">

                <Label
                    Text="Total"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="Black" />

                <Label
                    x:Name="TotalAmountLabel"
                    Grid.Column="1"
                    Text="₹0.00"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="MidnightBlue" />

                <Button
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Text="Clear Cart"
                    Clicked="ClearCartButton_Clicked"
                    BackgroundColor="Transparent"
                    TextColor="Red"
                    FontAttributes="Bold"
                    HeightRequest="40" />

                <Button
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Text="Proceed to Checkout"
                    Clicked="CheckoutButton_Clicked"
                    BackgroundColor="Goldenrod"
                    TextColor="White"
                    FontSize="17"
                    FontAttributes="Bold"
                    CornerRadius="15" />

            </Grid>

        </Frame>
        <!-- ===================================================== -->
        <!-- FIXED BOTTOM NAVIGATION -->
        <!-- ===================================================== -->

        <views:CustomerBottomNavigation
            Grid.Row="3" />


    </Grid>

</ContentPage>