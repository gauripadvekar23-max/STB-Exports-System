<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="STB_Exports.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:STB_Exports.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,70">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <views:CustomerHeaderFooter
            Grid.Row="0" />


        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20"
                Spacing="10">

                <!-- TITLE -->

                <Label
                    Text="Settings"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="MidnightBlue" />


                <!-- ================================================= -->
                <!-- PREFERENCES -->
                <!-- ================================================= -->

                <Label
                    Text="Preferences"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="Goldenrod"
                    Margin="5,10,0,5" />


                <!-- NOTIFICATIONS -->

                <Frame
                    Padding="15"
                    CornerRadius="12"
                    BackgroundColor="White"
                    BorderColor="LightGray"
                    HasShadow="False">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <VerticalStackLayout>

                            <Label
                                Text="Notifications"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="Black" />

                            <Label
                                Text="Receive order and promotional notifications"
                                FontSize="12"
                                TextColor="Gray" />

                        </VerticalStackLayout>

                        <Switch
                            x:Name="NotificationSwitch"
                            Grid.Column="1"
                            IsToggled="True" />

                    </Grid>

                </Frame>


                <!-- ================================================= -->
                <!-- ACCOUNT -->
                <!-- ================================================= -->

                <Label
                    Text="Account"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="Goldenrod"
                    Margin="5,15,0,5" />


                <!-- ACCOUNT INFORMATION -->

                <Frame
                    Padding="15"
                    CornerRadius="12"
                    BackgroundColor="White"
                    BorderColor="LightGray"
                    HasShadow="False">

                    <Frame.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="AccountInformation_Clicked" />

                    </Frame.GestureRecognizers>

                    <Grid
                        ColumnDefinitions="Auto,*,Auto">

                        <Label
                            Text="👤"
                            FontSize="20"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="Account Information"
                            FontSize="16"
                            TextColor="Black"
                            VerticalOptions="Center"
                            Margin="10,0" />

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="25"
                            TextColor="Gray"
                            VerticalOptions="Center" />

                    </Grid>

                </Frame>


                <!-- CHANGE PASSWORD -->

                <Frame
                    Padding="15"
                    CornerRadius="12"
                    BackgroundColor="White"
                    BorderColor="LightGray"
                    HasShadow="False">

                    <Frame.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="ChangePassword_Clicked" />

                    </Frame.GestureRecognizers>

                    

                </Frame>


                <!-- ================================================= -->
                <!-- ABOUT -->
                <!-- ================================================= -->

                <Label
                    Text="About"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="Goldenrod"
                    Margin="5,15,0,5" />


                <!-- ABOUT STB -->

                <Frame
                    Padding="15"
                    CornerRadius="12"
                    BackgroundColor="White"
                    BorderColor="LightGray"
                    HasShadow="False">

                    <Frame.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="About_Clicked" />

                    </Frame.GestureRecognizers>

                    <Grid
                        ColumnDefinitions="Auto,*,Auto">

                        <Label
                            Text="ℹ️"
                            FontSize="20"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="About STB Exports"
                            FontSize="16"
                            TextColor="Black"
                            VerticalOptions="Center"
                            Margin="10,0" />

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="25"
                            TextColor="Gray"
                            VerticalOptions="Center" />

                    </Grid>

                </Frame>


                <!-- ================================================= -->
                <!-- PRIVACY -->
                <!-- ================================================= -->

                <Frame
                    Padding="15"
                    CornerRadius="12"
                    BackgroundColor="White"
                    BorderColor="LightGray"
                    HasShadow="False">

                    <Frame.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="PrivacyPolicy_Clicked" />

                    </Frame.GestureRecognizers>

                    <Grid
                        ColumnDefinitions="Auto,*,Auto">

                        <Label
                            Text="🔐"
                            FontSize="20"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="Privacy Policy"
                            FontSize="16"
                            TextColor="Black"
                            VerticalOptions="Center"
                            Margin="10,0" />

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="25"
                            TextColor="Gray"
                            VerticalOptions="Center" />

                    </Grid>

                </Frame>


                <!-- TERMS -->

                <Frame
                    Padding="15"
                    CornerRadius="12"
                    BackgroundColor="White"
                    BorderColor="LightGray"
                    HasShadow="False">

                    <Frame.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="Terms_Clicked" />

                    </Frame.GestureRecognizers>

                    <Grid
                        ColumnDefinitions="Auto,*,Auto">

                        <Label
                            Text="📄"
                            FontSize="20"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="Terms &amp; Conditions"
                            FontSize="16"
                            TextColor="Black"
                            VerticalOptions="Center"
                            Margin="10,0" />

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="25"
                            TextColor="Gray"
                            VerticalOptions="Center" />

                    </Grid>

                </Frame>


                <!-- ================================================= -->
                <!-- LOGOUT -->
                <!-- ================================================= -->

                <Button
                    Text="Logout"
                    BackgroundColor="IndianRed"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    Margin="0,20,0,10"
                    Clicked="LogoutButton_Clicked" />

            </VerticalStackLayout>

        </ScrollView>


        <!-- ===================================================== -->
        <!-- BOTTOM NAVIGATION -->
        <!-- ===================================================== -->

        <views:CustomerBottomNavigation
            Grid.Row="2" />

    </Grid>

</ContentPage>