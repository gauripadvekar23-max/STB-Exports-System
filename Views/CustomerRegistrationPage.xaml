<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="STB_Exports.Views.CustomerRegistrationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="MidnightBlue">

    <Grid>

        <!-- BACKGROUND -->
        <Image
            Source="background.png"
            Aspect="AspectFill" />

        <!-- OVERLAY -->
        <BoxView Opacity="0.78">
            <BoxView.Background>
                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="1,1">

                    <GradientStop
                        Color="MidnightBlue"
                        Offset="0.0" />

                    <GradientStop
                        Color="DarkSlateBlue"
                        Offset="0.5" />

                    <GradientStop
                        Color="Black"
                        Offset="1.0" />

                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>


        <ScrollView>

            <VerticalStackLayout
                Padding="20,35,20,30"
                Spacing="8"
                HorizontalOptions="Center">

                <!-- LOGO -->
                <Image
                    Source="logo.png"
                    WidthRequest="110"
                    HeightRequest="110"
                    Aspect="AspectFit"
                    HorizontalOptions="Center" />

                <!-- COMPANY -->
                <Label
                    Text="SAMARTHA TRADE BRIDGE"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="White"
                    CharacterSpacing="1.5"
                    HorizontalTextAlignment="Center" />

                <!-- REGISTRATION CARD -->
                <Frame
                    WidthRequest="420"
                    Padding="28"
                    Margin="0,10,0,0"
                    CornerRadius="28"
                    BackgroundColor="White"
                    BorderColor="Goldenrod"
                    HasShadow="True"
                    HorizontalOptions="Center">

                    <VerticalStackLayout Spacing="7">

                        <!-- TITLE -->
                        <Label
                            Text="CREATE ACCOUNT"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Register to create your customer account"
                            FontSize="14"
                            TextColor="Gray"
                            HorizontalTextAlignment="Center"
                            Margin="0,-2,0,12" />


                        <!-- ========================= -->
                        <!-- FULL NAME -->
                        <!-- ========================= -->

                        <Label
                            Text="Full Name"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue" />

                        <Frame
                            x:Name="FullNameFrame"
                            Padding="12,4"
                            CornerRadius="15"
                            BorderColor="LightGray"
                            BackgroundColor="White"
                            HasShadow="False">

                            <Grid
                                ColumnDefinitions="35,*">

                                <Image
                                    Source="person.png"
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    VerticalOptions="Center" />

                                <Entry
                                    x:Name="FullNameEntry"
                                    Grid.Column="1"
                                    Placeholder="Enter your full name"
                                    TextColor="Black"
                                    PlaceholderColor="Gray"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    ReturnType="Next"
                                    TextChanged="FullNameEntry_TextChanged"
                                    Unfocused="FullNameEntry_Unfocused" />

                            </Grid>

                        </Frame>

                        <Label
                            x:Name="FullNameErrorLabel"
                            Text=""
                            FontSize="12"
                            TextColor="Red"
                            IsVisible="False"
                            Margin="8,0,0,2" />


                        <!-- ========================= -->
                        <!-- EMAIL -->
                        <!-- ========================= -->

                        <Label
                            Text="Email Address"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue" />

                        <Frame
                            x:Name="EmailFrame"
                            Padding="12,4"
                            CornerRadius="15"
                            BorderColor="LightGray"
                            BackgroundColor="White"
                            HasShadow="False">

                            <Grid
                                ColumnDefinitions="35,*">

                                <Image
                                    Source="email.png"
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    VerticalOptions="Center" />

                                <Entry
                                    x:Name="EmailEntry"
                                    Grid.Column="1"
                                    Placeholder="Enter your email"
                                    Keyboard="Email"
                                    TextColor="Black"
                                    PlaceholderColor="Gray"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    ReturnType="Next"
                                    TextChanged="EmailEntry_TextChanged"
                                    Unfocused="EmailEntry_Unfocused" />

                            </Grid>

                        </Frame>

                        <Label
                            x:Name="EmailErrorLabel"
                            Text=""
                            FontSize="12"
                            TextColor="Red"
                            IsVisible="False"
                            Margin="8,0,0,2" />


                        <!-- ========================= -->
                        <!-- PASSWORD -->
                        <!-- ========================= -->

                        <Label
                            Text="Password"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue" />

                        <Frame
                            x:Name="PasswordFrame"
                            Padding="12,4"
                            CornerRadius="15"
                            BorderColor="LightGray"
                            BackgroundColor="White"
                            HasShadow="False">

                            <Grid
                                ColumnDefinitions="35,*,35">

                                <Image
                                    Source="lock.png"
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    VerticalOptions="Center" />

                                <Entry
                                    x:Name="PasswordEntry"
                                    Grid.Column="1"
                                    Placeholder="Enter password"
                                    IsPassword="True"
                                    TextColor="Black"
                                    PlaceholderColor="Gray"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    ReturnType="Next"
                                    TextChanged="PasswordEntry_TextChanged"
                                    Unfocused="PasswordEntry_Unfocused" />

                                <ImageButton
                                    x:Name="ShowPasswordButton"
                                    Grid.Column="2"
                                    Source="eye_closed.png"
                                    BackgroundColor="Transparent"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Padding="2"
                                    Clicked="ShowPassword_Clicked" />

                            </Grid>

                        </Frame>

                        <Label
                            x:Name="PasswordErrorLabel"
                            Text=""
                            FontSize="12"
                            TextColor="Red"
                            IsVisible="False"
                            Margin="8,0,0,2" />


                        <!-- ========================= -->
                        <!-- CONFIRM PASSWORD -->
                        <!-- ========================= -->

                        <Label
                            Text="Confirm Password"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue" />

                        <Frame
                            x:Name="ConfirmPasswordFrame"
                            Padding="12,4"
                            CornerRadius="15"
                            BorderColor="LightGray"
                            BackgroundColor="White"
                            HasShadow="False">

                            <Grid
                                ColumnDefinitions="35,*,35">

                                <Image
                                    Source="lock.png"
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    VerticalOptions="Center" />

                                <Entry
                                    x:Name="ConfirmPasswordEntry"
                                    Grid.Column="1"
                                    Placeholder="Confirm your password"
                                    IsPassword="True"
                                    TextColor="Black"
                                    PlaceholderColor="Gray"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    ReturnType="Done"
                                    TextChanged="ConfirmPasswordEntry_TextChanged"
                                    Unfocused="ConfirmPasswordEntry_Unfocused" />

                                <ImageButton
                                    x:Name="ShowConfirmPasswordButton"
                                    Grid.Column="2"
                                    Source="eye_closed.png"
                                    BackgroundColor="Transparent"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Padding="2"
                                    Clicked="ShowConfirmPassword_Clicked" />

                            </Grid>

                        </Frame>

                        <Label
                            x:Name="ConfirmPasswordErrorLabel"
                            Text=""
                            FontSize="12"
                            TextColor="Red"
                            IsVisible="False"
                            Margin="8,0,0,2" />


                        <!-- REGISTER -->
                        <Button
                            Text="CREATE ACCOUNT"
                            HeightRequest="55"
                            CornerRadius="18"
                            BackgroundColor="Goldenrod"
                            TextColor="White"
                            FontSize="17"
                            FontAttributes="Bold"
                            Margin="0,10,0,0"
                            Clicked="RegisterButton_Clicked" />


                        <!-- BACK TO LOGIN -->
                        <Button
                            Text="Already have an account? Login"
                            BackgroundColor="Transparent"
                            TextColor="Goldenrod"
                            FontAttributes="Bold"
                            FontSize="14"
                            Clicked="BackToLoginButton_Clicked"
                            Padding="0" />

                    </VerticalStackLayout>

                </Frame>

                <Label
                    Text="© Samartha Trade Bridge Pvt. Ltd."
                    FontSize="13"
                    TextColor="LightGray"
                    HorizontalTextAlignment="Center"
                    Margin="0,12,0,0" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>