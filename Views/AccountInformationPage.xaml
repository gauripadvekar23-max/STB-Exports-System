<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Name="AccountPage"
    x:Class="STB_Exports.Views.AccountInformationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:STB_Exports.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">

    <Grid
        RowDefinitions="Auto,*,70">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="0"
            BackgroundColor="White"
            Padding="20,15"
            ColumnDefinitions="50,*">

            
            <!-- TITLE -->

            <Label
                Grid.Column="1"
                Text="Saved Addresses"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="Black"
                VerticalOptions="Center" />

        </Grid>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollView
            Grid.Row="1">

            <VerticalStackLayout
                Padding="20"
                Spacing="15">


                <!-- ================================================= -->
                <!-- ADD NEW ADDRESS -->
                <!-- ================================================= -->

                <Button
                    Text="+   Add New"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="MidnightBlue"
                    BackgroundColor="#E8F0FA"
                    BorderColor="#D5DCE5"
                    BorderWidth="1"
                    CornerRadius="18"
                    HeightRequest="70"
                    HorizontalOptions="Fill"
                    Clicked="AddAddress_Clicked" />


                <!-- ================================================= -->
                <!-- SECTION TITLE -->
                <!-- ================================================= -->

                <Label
                    Text="Saved addresses"
                    FontSize="19"
                    FontAttributes="Bold"
                    TextColor="#333333"
                    Margin="0,10,0,0" />


                <!-- ================================================= -->
                <!-- ADDRESS LIST -->
                <!-- ================================================= -->

                <CollectionView
                    x:Name="AddressesCollection"
                    SelectionMode="None">

                    <!-- EMPTY VIEW -->

                    <CollectionView.EmptyView>

                        <VerticalStackLayout
                            Padding="30"
                            Spacing="8"
                            HorizontalOptions="Center">

                            <Label
                                Text="⌂"
                                FontSize="45"
                                TextColor="Gray"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="No saved addresses"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="Gray"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Tap '+ Add New' to add your first address."
                                FontSize="13"
                                TextColor="Gray"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </CollectionView.EmptyView>


                    <!-- ================================================= -->
                    <!-- ADDRESS CARD -->
                    <!-- ================================================= -->

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Stroke="#CFCFCF"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="15"
                                Margin="0,5"
                                StrokeShape="RoundRectangle 22">

                                <Grid
                                    ColumnDefinitions="125,*,Auto"
                                    RowDefinitions="Auto,Auto,Auto">


                                    <!-- ================================================= -->
                                    <!-- ADDRESS ICON -->
                                    <!-- ================================================= -->

                                    <Border
                                        Grid.RowSpan="3"
                                        Grid.Column="0"
                                        WidthRequest="120"
                                        HeightRequest="120"
                                        BackgroundColor="#F1F1F1"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 18"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="⌂"
                                            FontSize="55"
                                            TextColor="Black"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Border>


                                    <!-- ================================================= -->
                                    <!-- NAME -->
                                    <!-- ================================================= -->

                                    <Label
                                        Grid.Column="1"
                                        Grid.Row="0"
                                        Text="{Binding FullName}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#222222"
                                        LineBreakMode="TailTruncation" />


                                    <!-- ================================================= -->
                                    <!-- ADDRESS -->
                                    <!-- ================================================= -->

                                    <Label
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Text="{Binding Address}"
                                        FontSize="14"
                                        TextColor="Gray"
                                        MaxLines="3"
                                        LineBreakMode="TailTruncation"
                                        Margin="0,5,0,0" />


                                    <!-- ================================================= -->
                                    <!-- CITY STATE PINCODE -->
                                    <!-- ================================================= -->

                                    <Label
                                        Grid.Column="1"
                                        Grid.Row="2"
                                        Text="{Binding CityStatePincode}"
                                        FontSize="14"
                                        TextColor="Gray"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation" />


                                    <!-- ================================================= -->
                                    <!-- PHONE -->
                                    <!-- ================================================= -->

                                    <Label
                                        Grid.Column="1"
                                        Grid.Row="2"
                                        Text="{Binding PhoneNumber}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#333333"
                                        Margin="0,25,0,0" />


                                    <!-- ================================================= -->
                                    <!-- THREE DOT MENU -->
                                    <!-- ================================================= -->

                                    <VerticalStackLayout
    Grid.Column="2"
    Grid.Row="0"
    Grid.RowSpan="3"
    Spacing="8"
    VerticalOptions="Center">

                                        <!-- SELECT ADDRESS -->

                                        <Button
        Text="Select"
        FontSize="14"
        FontAttributes="Bold"
        BackgroundColor="Goldenrod"
        TextColor="White"
        CornerRadius="10"
        Padding="12,8"
        Clicked="SelectAddress_Clicked"
        CommandParameter="{Binding .}"/>

                                        <!-- MENU -->

                                        <Button
        Text="⋮"
        FontSize="28"
        BackgroundColor="Transparent"
        TextColor="Black"
        Padding="0"
        Clicked="AddressMenu_Clicked"
        CommandParameter="{Binding .}"
        VerticalOptions="Center" />

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>


        <!-- ================================================= -->
        <!-- BOTTOM NAVIGATION -->
        <!-- ================================================= -->

        <views:CustomerBottomNavigation
            Grid.Row="2" />

    </Grid>

</ContentPage>