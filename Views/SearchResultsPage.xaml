<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="STB_Exports.Views.SearchResultsPage"
    Title="Search Results"
    BackgroundColor="White">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <!-- BACK BUTTON -->

            <Button
                Text="← Back"
                Clicked="BackButton_Clicked"
                HorizontalOptions="Start"
                BackgroundColor="Transparent"
                TextColor="SaddleBrown"
                FontSize="16"
                Padding="0" />

            <!-- SEARCH TITLE -->

            <Label
                Text="Search Results"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="MidnightBlue" />

            <Label
                x:Name="SearchTextLabel"
                Text="Search products"
                FontSize="18"
                TextColor="Gray" />

            <!-- NO RESULTS -->

            <Label
                x:Name="NoResultsLabel"
                Text="No products found."
                FontSize="18"
                TextColor="Gray"
                HorizontalTextAlignment="Center"
                IsVisible="False"
                Margin="0,30" />

            <!-- PRODUCTS -->

            <CollectionView
                x:Name="SearchResultsCollection"
                SelectionMode="None">

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="15" />

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame
                            Padding="15"
                            CornerRadius="18"
                            BorderColor="LightGray"
                            BackgroundColor="White"
                            HasShadow="True">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="120" />

                                    <ColumnDefinition
                                        Width="*" />

                                </Grid.ColumnDefinitions>

                                <!-- PRODUCT IMAGE -->

                                <Frame
                                    WidthRequest="110"
                                    HeightRequest="110"
                                    CornerRadius="15"
                                    Padding="5"
                                    BackgroundColor="#FDF5E6"
                                    BorderColor="#DEB887"
                                    HasShadow="False">

                                    <Image
                                        Source="{Binding Image}"
                                        Aspect="AspectFit" />

                                </Frame>

                                <!-- PRODUCT INFORMATION -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Margin="15,0,0,0"
                                    Spacing="7"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="Black" />

                                    <Label
                                        Text="Premium Export Quality"
                                        FontSize="13"
                                        TextColor="ForestGreen" />

                                    <Label
                                        Text="★★★★★  5.0"
                                        FontSize="14"
                                        TextColor="Goldenrod" />

                                    <Button
                                        Text="View Details"
                                        Clicked="ProductDetails_Clicked"
                                        BackgroundColor="Goldenrod"
                                        TextColor="White"
                                        CornerRadius="10"
                                        HeightRequest="40"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Grid>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>