<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="STB_Exports.Views.OrdersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:STB_Exports.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,70">

        <!-- ================= HEADER ================= -->

        <views:CustomerHeaderFooter
            Grid.Row="0" />


        <!-- ================= CONTENT ================= -->

        <Grid
    Grid.Row="1"
    Padding="15"
    RowDefinitions="Auto,*">

            <!-- PAGE TITLE -->

            <Label
        Grid.Row="0"
        Text="My Orders"
        FontSize="24"
        FontAttributes="Bold"
        TextColor="MidnightBlue"
        Margin="0,0,0,15" />


            <!-- ================= ORDERS LIST ================= -->

            <CollectionView
        Grid.Row="1"
        x:Name="OrdersCollectionView"
        SelectionMode="None"
        VerticalOptions="FillAndExpand"
        VerticalScrollBarVisibility="Always">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                Orientation="Vertical"
                ItemSpacing="0" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame
                    Margin="0,0,0,12"
                    Padding="15"
                    CornerRadius="12"
                    BackgroundColor="White"
                    BorderColor="#DDDDDD"
                    HasShadow="True">

                            <VerticalStackLayout
                        Spacing="8">

                                <!-- ORDER NUMBER -->

                                <Label
                            Text="{Binding OrderNumber, StringFormat='Order #{0}'}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="MidnightBlue" />


                                <!-- ORDER DATE -->

                                <Label
                            Text="{Binding OrderDate, StringFormat='Order Date: {0:dd MMM yyyy}'}"
                            FontSize="14"
                            TextColor="Gray" />


                                <!-- EXPECTED DELIVERY -->

                                <Label
                            Text="{Binding ExpectedDeliveryDate, StringFormat='Expected Delivery: {0:dd MMM yyyy}'}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="Goldenrod" />


                                <!-- STATUS -->

                                <Label
                            Text="{Binding OrderStatus, StringFormat='Status: {0}'}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="Green" />


                                <!-- PAYMENT -->

                                <Label
                            Text="{Binding PaymentMethod, StringFormat='Payment: {0}'}"
                            FontSize="14"
                            TextColor="Black" />


                                <!-- PAYMENT STATUS -->

                                <Label
                            Text="{Binding PaymentStatus, StringFormat='Payment Status: {0}'}"
                            FontSize="14"
                            TextColor="Black" />


                                <!-- TOTAL -->

                                <Grid
                            ColumnDefinitions="*,Auto"
                            Margin="0,5,0,0">

                                    <Label
                                Text="Total Amount"
                                FontSize="15"
                                TextColor="Gray"
                                VerticalOptions="Center" />

                                    <Label
                                Grid.Column="1"
                                Text="{Binding TotalAmount, StringFormat='₹{0:0.00}'}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="Goldenrod" />

                                </Grid>


                                <!-- VIEW DETAILS -->

                                <Button
                            Text="View Details"
                            Clicked="ViewOrderDetails_Clicked"
                            CommandParameter="{Binding .}"
                            BackgroundColor="MidnightBlue"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="45"
                            Margin="0,5,0,0" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>


            <!-- ================= EMPTY ORDERS ================= -->

            <VerticalStackLayout
        x:Name="EmptyOrdersLayout"
        Grid.Row="1"
        IsVisible="False"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Spacing="10">

                <Label
            Text="📦"
            FontSize="55"
            HorizontalTextAlignment="Center" />

                <Label
            Text="No Orders Yet"
            FontSize="22"
            FontAttributes="Bold"
            TextColor="MidnightBlue"
            HorizontalTextAlignment="Center" />

                <Label
            Text="Your placed orders will appear here."
            FontSize="14"
            TextColor="Gray"
            HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Grid>


        <!-- ================= BOTTOM NAVIGATION ================= -->

        <views:CustomerBottomNavigation
            Grid.Row="2" />

    </Grid>

</ContentPage>