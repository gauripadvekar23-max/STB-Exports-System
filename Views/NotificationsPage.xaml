<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="STB_Exports.Views.NotificationsPage"
    Title="Notifications"
    BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Padding="20,15"
            BackgroundColor="Navy"
            ColumnDefinitions="*,Auto">

            <Label
                Text="Notifications"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>


        <!-- Content -->
        <Grid
            Grid.Row="1"
            Padding="15">

            <!-- Notifications -->
            <CollectionView
                x:Name="NotificationsCollectionView"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="10">

                        <Label
                            Text="🔔"
                            FontSize="45"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="No notifications"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="Gray"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Your order updates will appear here."
                            FontSize="14"
                            TextColor="Gray"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>


                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame
                            Margin="0,5"
                            Padding="15"
                            CornerRadius="15"
                            BackgroundColor="White"
                            BorderColor="LightGray"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="8">

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label
                                        Text="{Binding OrderNumber}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="Navy" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding OrderStatus}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="Green"
                                        VerticalOptions="Center" />

                                </Grid>


                                <Label
                                    Text="{Binding Message}"
                                    FontSize="15"
                                    TextColor="Black" />


                                <Label
                                    Text="{Binding CreatedAt, StringFormat='Updated: {0:dd MMM yyyy, hh:mm tt}'}"
                                    FontSize="12"
                                    TextColor="Gray" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>